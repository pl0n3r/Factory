#!/usr/bin/env bash
set -euo pipefail
[[ "${FACTORY_PREVIEW:-}" == "1" ]] || { echo "adapter template: producción no configurada" >&2; exit 1; }
[[ "${FACTORY_SYNTHETIC_DATA:-}" == "1" ]] || { echo "adapter template: se requieren datos sintéticos" >&2; exit 1; }
: "${FACTORY_PREVIEW_ROOT:?FACTORY_PREVIEW_ROOT requerido}"
rm -rf "$FACTORY_PREVIEW_ROOT/deployed"
if [[ -f "$FACTORY_PREVIEW_ROOT/state/backup" ]]; then
  cp "$FACTORY_PREVIEW_ROOT/state/backup" "$FACTORY_PREVIEW_ROOT/state/current"
fi
