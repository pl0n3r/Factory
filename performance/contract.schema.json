{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pl0n3r/factory/performance/contract.schema.json",
  "title": "Factory Performance Contract v1",
  "type": "object", "additionalProperties": false, "required": ["version", "project", "surfaces"],
  "properties": {
    "version": {"const": 1}, "project": {"$ref": "#/$defs/id"},
    "surfaces": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/surface"}}
  },
  "$defs": {
    "surface": {"type": "object", "additionalProperties": false, "required": ["id", "label", "metrics"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"},
        "metrics": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/metric"}}}},
    "metric": {"type": "object", "additionalProperties": false,
      "required": ["id", "label", "baseline", "budget", "window", "freshness", "evidence", "allowed_actions", "escalation_conditions"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"},
        "baseline": {"$ref": "#/$defs/measurement"}, "budget": {"$ref": "#/$defs/budget"},
        "window": {"$ref": "#/$defs/window"}, "freshness": {"$ref": "#/$defs/freshness"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "allowed_actions": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"enum": ["observe", "diagnose", "benchmark", "create_work_item", "measure_before_after"]}},
        "escalation_conditions": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"enum": ["cost_change", "architecture_change", "consistency_risk", "business_semantics", "destructive_migration", "sensitive_data", "capacity_budget"]}}}},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["value", "unit", "observed_at"],
      "properties": {"value": {"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000},
        "unit": {"$ref": "#/$defs/unit"}, "observed_at": {"type": "string", "format": "date-time"}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["operator", "value", "unit"],
      "properties": {"operator": {"enum": ["lte", "gte"]}, "value": {"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000}, "unit": {"$ref": "#/$defs/unit"}}},
    "window": {"type": "object", "additionalProperties": false, "required": ["duration_seconds", "min_samples"],
      "properties": {"duration_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000}, "min_samples": {"type": "integer", "minimum": 1, "maximum": 10000000}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["max_age_seconds"],
      "properties": {"max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["source", "ref", "observed_at"],
      "properties": {"source": {"$ref": "#/$defs/id"}, "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@-]{0,239}$"}, "observed_at": {"type": "string", "format": "date-time"}}},
    "unit": {"enum": ["ms", "s", "bytes", "kb", "mb", "count", "rps", "rpm", "percent", "ratio"]},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 160}
  }
}
