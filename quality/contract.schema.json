{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pl0n3r/factory/quality/contract.schema.json",
  "title": "Factory Quality Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "surfaces", "invariants", "compatibility", "accessibility", "migration", "smoke", "evidence_freshness_seconds", "dimensions"],
  "properties": {
    "version": {"const": 1},
    "project": {"$ref": "#/$defs/id"},
    "surfaces": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/surface"}},
    "invariants": {"$ref": "#/$defs/idList"},
    "compatibility": {"type": "object", "additionalProperties": false, "required": ["runtimes", "browsers", "devices"], "properties": {"runtimes": {"$ref": "#/$defs/idListEmpty"}, "browsers": {"$ref": "#/$defs/idListEmpty"}, "devices": {"$ref": "#/$defs/idListEmpty"}}},
    "accessibility": {"type": "object", "additionalProperties": false, "required": ["target"], "properties": {"target": {"enum": ["NOT_APPLICABLE", "WCAG_AA", "WCAG_AAA"]}}},
    "migration": {"type": "object", "additionalProperties": false, "required": ["strategy"], "properties": {"strategy": {"enum": ["NOT_APPLICABLE", "FORWARD_ROLLBACK", "EXPAND_CONTRACT"]}}},
    "smoke": {"$ref": "#/$defs/externalRef"},
    "evidence_freshness_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["performance", "recovery"], "properties": {"performance": {"$ref": "#/$defs/externalRef"}, "recovery": {"$ref": "#/$defs/externalRef"}}}
  },
  "$defs": {
    "surface": {"type": "object", "additionalProperties": false, "required": ["id", "criticality", "required_gates"], "properties": {"id": {"$ref": "#/$defs/id"}, "criticality": {"enum": ["low", "medium", "high", "critical"]}, "required_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["unit", "integration", "contract", "database", "tenancy", "e2e", "browser", "mobile", "accessibility", "security", "performance", "resilience", "migration", "smoke", "observability"]}}}},
    "externalRef": {"type": "object", "additionalProperties": false, "required": ["required", "source_ref"], "properties": {"required": {"type": "boolean"}, "source_ref": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@-]{0,239}$"}}},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"},
    "idList": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "idListEmpty": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
