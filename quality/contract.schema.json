{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pl0n3r/factory/quality/contract.schema.json",
  "title": "Factory Quality Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "surfaces",
    "invariants",
    "compatibility",
    "accessibility",
    "migration",
    "smoke",
    "evidence_freshness_seconds",
    "dimensions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "$ref": "#/$defs/id"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "invariants": {
      "$ref": "#/$defs/idList"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimes",
        "browsers",
        "devices"
      ],
      "properties": {
        "runtimes": {
          "$ref": "#/$defs/idListEmpty"
        },
        "browsers": {
          "$ref": "#/$defs/idListEmpty"
        },
        "devices": {
          "$ref": "#/$defs/idListEmpty"
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "enum": [
            "NOT_APPLICABLE",
            "WCAG_AA",
            "WCAG_AAA"
          ]
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "NOT_APPLICABLE",
            "FORWARD_ROLLBACK",
            "EXPAND_CONTRACT"
          ]
        }
      }
    },
    "smoke": {
      "$ref": "#/$defs/externalRef"
    },
    "evidence_freshness_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performance",
        "recovery"
      ],
      "properties": {
        "performance": {
          "$ref": "#/$defs/externalRef"
        },
        "recovery": {
          "$ref": "#/$defs/externalRef"
        }
      }
    },
    "sonar": {
      "$ref": "#/$defs/sonar"
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "criticality",
        "required_gates"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "criticality": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "unit",
              "integration",
              "contract",
              "database",
              "tenancy",
              "e2e",
              "browser",
              "mobile",
              "accessibility",
              "security",
              "performance",
              "resilience",
              "migration",
              "smoke",
              "observability"
            ]
          }
        }
      }
    },
    "sonar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_visibility",
        "analysis_method",
        "max_analysis_age_seconds",
        "max_organization_line_usage_percent",
        "max_open_vulnerabilities",
        "max_open_bugs",
        "max_open_hotspots",
        "max_debt_age_days"
      ],
      "properties": {
        "expected_visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "analysis_method": {
          "enum": [
            "automatic",
            "ci"
          ]
        },
        "max_analysis_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "max_organization_line_usage_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_open_vulnerabilities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "max_open_bugs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "max_open_hotspots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "max_debt_age_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36500
        },
        "applicability": {
          "$ref": "#/$defs/sonarApplicability"
        }
      }
    },
    "externalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "source_ref"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@-]{0,239}$"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "idListEmpty": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "sonarApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "organization_line_usage"
      ],
      "properties": {
        "coverage": {
          "$ref": "#/$defs/sonarApplicabilityEntry"
        },
        "organization_line_usage": {
          "$ref": "#/$defs/sonarApplicabilityEntry"
        }
      }
    },
    "sonarApplicabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason",
        "source_ref"
      ],
      "properties": {
        "state": {
          "enum": [
            "required",
            "not_applicable"
          ]
        },
        "reason": {
          "$ref": "#/$defs/id"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@-]{0,239}$"
        }
      }
    }
  }
}
