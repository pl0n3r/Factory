{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.pl0n3r.dev/schemas/progress-readiness-v1.json",
  "title": "Factory Progress + Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "target", "baseline_fingerprint", "progress", "readiness",
    "dimensions", "critical_blockers", "blockers", "evidence_freshness", "evidence_refs"
  ],
  "properties": {
    "contract": {"const": "factory.progress-readiness.v1"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "version", "scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "baseline_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "progress": {"$ref": "#/$defs/metric"},
    "readiness": {"$ref": "#/$defs/metric"},
    "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
    "critical_blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "evidence_freshness": {"enum": ["CURRENT", "STALE", "UNKNOWN"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percent", "status"],
      "properties": {
        "percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "status": {"enum": ["UNKNOWN", "BUILDING", "COMPLETE", "READY", "BLOCKED"]}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "effective_value", "evidence_refs"],
      "properties": {
        "state": {"enum": ["DEMONSTRATED", "PARTIAL", "NOT_DEMONSTRATED", "UNKNOWN"]},
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "effective_value": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "weight", "freshness", "progress", "readiness"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "freshness": {"enum": ["CURRENT", "STALE", "UNKNOWN"]},
        "progress": {"$ref": "#/$defs/signal"},
        "readiness": {"$ref": "#/$defs/signal"}
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "weight", "applicability", "progress_percent", "readiness_percent", "milestones"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
        "progress_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "readiness_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "milestones": {"type": "array", "items": {"$ref": "#/$defs/milestone"}}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "status", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "status": {"enum": ["OPEN", "CLOSED"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
