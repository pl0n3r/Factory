{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pl0n3r/factory/readme/progress_readiness.schema.json",
  "title": "Factory Progress + Readiness Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "target_fingerprint",
    "observed_at",
    "progress",
    "readiness",
    "evidence_freshness",
    "dimensions",
    "blockers",
    "critical_blockers",
    "trend"
  ],
  "properties": {
    "version": { "const": 1 },
    "target": { "$ref": "#/$defs/target" },
    "target_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "progress": {
      "allOf": [
        { "$ref": "#/$defs/aggregateMetric" },
        {
          "type": "object",
          "properties": {
            "status": { "enum": ["MEASURED", "UNKNOWN"] }
          },
          "required": ["status"]
        }
      ]
    },
    "readiness": {
      "allOf": [
        { "$ref": "#/$defs/aggregateMetric" },
        {
          "type": "object",
          "properties": {
            "status": { "enum": ["READY", "BUILDING", "BLOCKED", "UNKNOWN"] }
          },
          "required": ["status"]
        }
      ]
    },
    "evidence_freshness": {
      "enum": ["CURRENT", "DEGRADED"]
    },
    "dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimension" },
      "maxItems": 50
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" },
      "maxItems": 100
    },
    "critical_blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" },
      "maxItems": 100
    },
    "trend": { "$ref": "#/$defs/trend" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "scope", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "scope": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" }
      }
    },
    "aggregateMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_points",
        "percent",
        "dimension_weight",
        "contributions",
        "status"
      ],
      "properties": {
        "basis_points": { "$ref": "#/$defs/basisPointsNullable" },
        "percent": { "$ref": "#/$defs/percentNullable" },
        "dimension_weight": {
          "type": "integer",
          "minimum": 0
        },
        "contributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/contribution" }
        },
        "status": { "type": "string" }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "weight",
        "basis_points",
        "evidence_refs",
        "unknown_or_stale"
      ],
      "properties": {
        "dimension_id": { "$ref": "#/$defs/id" },
        "weight": { "$ref": "#/$defs/weight" },
        "basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "evidence_refs": { "$ref": "#/$defs/refs" },
        "unknown_or_stale": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "weight",
        "progress",
        "readiness",
        "milestones"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "weight": { "$ref": "#/$defs/weight" },
        "progress": { "$ref": "#/$defs/dimensionMetric" },
        "readiness": { "$ref": "#/$defs/dimensionMetric" },
        "milestones": {
          "type": "array",
          "items": { "$ref": "#/$defs/milestone" },
          "minItems": 1,
          "maxItems": 100
        }
      }
    },
    "dimensionMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis_points",
        "percent",
        "satisfied_weight",
        "applicable_weight",
        "evidence_refs",
        "unknown_or_stale"
      ],
      "properties": {
        "status": { "enum": ["MEASURED", "NOT_APPLICABLE"] },
        "basis_points": { "$ref": "#/$defs/basisPointsNullable" },
        "percent": { "$ref": "#/$defs/percentNullable" },
        "satisfied_weight": {
          "type": "integer",
          "minimum": 0
        },
        "applicable_weight": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_refs": { "$ref": "#/$defs/refs" },
        "unknown_or_stale": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "weight",
        "progress_state",
        "readiness_state",
        "evidence_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "weight": { "$ref": "#/$defs/weight" },
        "progress_state": { "$ref": "#/$defs/evidenceState" },
        "readiness_state": { "$ref": "#/$defs/evidenceState" },
        "evidence_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "severity", "state", "evidence_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "severity": {
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "state": {
          "enum": ["OPEN", "RESOLVED", "UNKNOWN", "STALE"]
        },
        "evidence_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "comparable",
        "progress_delta_basis_points",
        "readiness_delta_basis_points",
        "causes"
      ],
      "properties": {
        "kind": { "enum": ["UNAVAILABLE", "TREND", "REBASELINE"] },
        "comparable": { "type": "boolean" },
        "progress_delta_basis_points": {
          "type": ["integer", "null"],
          "minimum": -10000,
          "maximum": 10000
        },
        "readiness_delta_basis_points": {
          "type": ["integer", "null"],
          "minimum": -10000,
          "maximum": 10000
        },
        "causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/changeCause" }
        }
      }
    },
    "changeCause": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["target_change", "milestone_change", "blocker_change"]
        }
      },
      "additionalProperties": true
    },
    "evidenceState": {
      "enum": [
        "SATISFIED",
        "UNSATISFIED",
        "UNKNOWN",
        "STALE",
        "NOT_APPLICABLE"
      ]
    },
    "basisPointsNullable": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 10000
    },
    "percentNullable": {
      "type": ["string", "null"],
      "pattern": "^(?:100\\.00|[0-9]{1,2}\\.[0-9]{2})$"
    },
    "weight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "refs": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  }
}
